# 复制为 .env 后按需修改。所有的值都是可选的。
# .env 已被 .gitignore 排除，不会进仓库。

# 时区
TZ=Asia/Shanghai

# 日志级别：WARNING / INFO / DEBUG
# 正常运行时桥只在 warning/error 才输出，设成 INFO 也不会更热闹。
MUSEBRIDGE_LOG_LEVEL=INFO

# 出网代理。
# hatch.metaaivm.com 在国内被 DNS 污染，直连会超时，一般必须填这里。
# 不需要代理（例如在境外主机）就留空。
# 例：HTTP_PROXY=http://192.168.1.10:7890
HTTP_PROXY=
HTTPS_PROXY=

# 不走代理的地址。默认已包含飞书域名和私有网段，通常不用改。
# NO_PROXY=localhost,127.0.0.1,::1,open.feishu.cn,.feishu.cn,.feishu.net,192.168.0.0/16
